{
  "name": "agenda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @agenda/api dev\" \"pnpm --filter @agenda/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "start": "pnpm --filter @agenda/api start",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:reset": "tsx scripts/database.ts reset",
    "db:test:prepare": "tsx scripts/database.ts test-prepare",
    "test": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "playwright test",
    "browser:install": "tsx scripts/install-browser.ts",
    "format": "prettier --write apps packages scripts tests docs README.md package.json tsconfig.base.json pnpm-workspace.yaml playwright.config.ts .prettierrc.json",
    "format:check": "prettier --check apps packages scripts tests docs README.md package.json tsconfig.base.json pnpm-workspace.yaml playwright.config.ts .prettierrc.json",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
