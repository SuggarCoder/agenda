# Copy this file to the repository root as .env on the deployment server.
# A public DNS name only: no https://, path, port or wildcard.
DOMAIN=attendance.example.com
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_DB=agenda
POSTGRES_USER=agenda
# Generate with: openssl rand -hex 32
# Single quotes keep $, # and other characters literal in Compose dotenv files.
POSTGRES_PASSWORD='REPLACE_WITH_A_RANDOM_PASSWORD'
HTTP_PORT=80
HTTPS_PORT=443
